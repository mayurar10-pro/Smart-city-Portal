# =====================================================================
# SmartCity Connect - Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your actual .env file to version control.

# Flask Core Configuration
SECRET_KEY=smartcity-connect-secure-session-key-change-in-production
FLASK_ENV=development
DEBUG=True

# Database Configuration (SQLite by default)
DATABASE_URL=sqlite:///instance/smartcity.db

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# =====================================================================
# SMS Gateway Provider (for Mobile OTP Verification)
# =====================================================================
# Set SMS_PROVIDER to 'development' for free simulated OTPs (displayed in flash message/dev banner)
# Set to 'twilio' for live SMS delivery via Twilio API
SMS_PROVIDER=development

# Twilio Credentials (required only if SMS_PROVIDER=twilio)
# Obtain from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================================
# Reverse Geocoding & Mapping Services
# =====================================================================
# GEOCODING_PROVIDER: 'nominatim' (OpenStreetMap free service, no API key required)
# or 'google' (Google Maps Geocoding API)
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =====================================================================
# Pre-seeded Authority Setup (Protected Non-Public Access)
# =====================================================================
DEFAULT_AUTHORITY_USERNAME=officer_admin
DEFAULT_AUTHORITY_PASSWORD=AuthorityPass@2026
DEFAULT_AUTHORITY_ROLE=Senior Municipal Officer
